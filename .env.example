# =============================================================================
# WDC Fitness — Environment Variables
# =============================================================================
# Kopiere zu .env.local für lokale Entwicklung.
# In Production: alle Werte in Vercel-Dashboard pflegen.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Direct DB connection für Drizzle Migrations (Supabase Dashboard → DB → Connection String → "URI")
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# PowerSync
NEXT_PUBLIC_POWERSYNC_URL=https://xxxxxxxx.powersync.journeyapps.com
POWERSYNC_TOKEN=eyJh...

# OpenRouter (alle LLM-Calls)
OPENROUTER_API_KEY=sk-or-v1-...

# Firecrawl (Webseiten-Extraktion)
FIRECRAWL_API_KEY=fc-...

# ElevenLabs (Audio→Text via Scribe)
ELEVENLABS_API_KEY=...

# Withings (Body-Metriken)
# Anlegen unter: https://developer.withings.com/dashboard
WITHINGS_CLIENT_ID=...
WITHINGS_CLIENT_SECRET=...
WITHINGS_REDIRECT_URI=https://wdc-fitness.vercel.app/api/integrations/withings/callback

# Strava (Activities lesen — Free-Tier reicht)
# Anlegen unter: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=...
STRAVA_CLIENT_SECRET=...
STRAVA_REDIRECT_URI=https://wdc-fitness.vercel.app/api/integrations/strava/callback

# Migros (default store für Stock-Lookup)
# Beim ersten Setup: search_stores ausführen, ID rauskopieren
MIGROS_DEFAULT_STORE_ID=

# App-Meta
NEXT_PUBLIC_APP_URL=https://wdc-fitness.vercel.app
